generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model personagens {
  id              Int   @id @default(autoincrement())
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  nome_jogador    String?
  nome_personagem String?
  classe          String?
  idade           Int?
  level           Int?
  vida            Int?
  sanidade        Int?
}
